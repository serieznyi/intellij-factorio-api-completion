<idea-plugin>
    <id>serieznyi.factorio.autocompletion</id>
    <name>Factorio LUA API Support Fork</name>
    <vendor email="serieznyi@gmail.com">Maxim Mironyuk</vendor>

    <description><![CDATA[
    <p>Fork of abandoned plugin <a  href="https://plugins.jetbrains.com/plugin/13330-factorio-lua-api-support">Factorio LUA API Support</a>.</p>
    <p>Adds Support for the Factorio LUA API. This implements a full code completion.</p>
    <p>To use the code completion, it has to be activated under `Settings > Languages & Frameworks > Factorio Autocompletion`</p>
    ]]>
    </description>

    <!-- please see https://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.lang</depends>
    <depends>com.tang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable groupId="language" displayName="Factorio Autocompletion"
                             id="preference.FactorioCompletionConfig"
                             instance="io.serieznyi.intellij.factorioapicompletion.intellij.FactorioConfig"/>
        <projectService serviceImplementation="io.serieznyi.intellij.factorioapicompletion.intellij.FactorioState"/>
        <postStartupActivity implementation="io.serieznyi.intellij.factorioapicompletion.intellij.FactorioStartupActivity"/>

        <additionalLibraryRootsProvider implementation="io.serieznyi.intellij.factorioapicompletion.intellij.FactorioLibraryProvider"/>

        <completion.contributor language="Lua"
                                implementationClass="io.serieznyi.intellij.factorioapicompletion.intellij.completion.MainCompletionContributor"
                                order="first"/>
        <completion.contributor language="Lua"
                                implementationClass="io.serieznyi.intellij.factorioapicompletion.intellij.completion.DataRawCompletionContributor"
                                order="first"/>

        <fileBasedIndex implementation="io.serieznyi.intellij.factorioapicompletion.intellij.PrototypeFileIndexer"/>

        <notificationGroup displayType="STICKY_BALLOON" id="Factorio LUA API Support"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="io.serieznyi.intellij.factorioapicompletion.json.FactorioSchemaProviderFactory"/>
    </extensions>

    <extensions defaultExtensionNs="com.tang.intellij.lua">
        <luaFileResolver implementation="io.serieznyi.intellij.factorioapicompletion.tang.file.resolver.FactorioRootDir" order="first"/>
        <luaFileResolver implementation="io.serieznyi.intellij.factorioapicompletion.tang.file.resolver.FactorioLualib" order="first"/>

        <luaTypeInfer implementation="io.serieznyi.intellij.factorioapicompletion.tang.DataRawTypeInfer" order="last"/>
    </extensions>

    <actions>
    </actions>
</idea-plugin>
